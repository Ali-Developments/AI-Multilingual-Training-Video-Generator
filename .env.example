# ==============================================================================
# AI Multilingual Training Video Generation Platform Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# Storage Directory
STORAGE_PATH=./storage/projects

# LLM Providers (Groq is default, extensible to any provider)
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Speech Synthesis (TTS) Providers (Edge-TTS is default free tier)
DEFAULT_TTS_PROVIDER=edge_tts
TTS_TIMEOUT_SECONDS=60
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Avatar Generation (HeyGen API)
DEFAULT_AVATAR_PROVIDER=mock
HEYGEN_API_KEY=your_heygen_api_key_here
HEYGEN_DEFAULT_AVATAR_ID=default_avatar_wayne
HEYGEN_POLL_INTERVAL_SECONDS=2.0
HEYGEN_JOB_TIMEOUT_SECONDS=300

# Cost Safety Guard (Must remain False during testing to prevent paid API calls)
ENABLE_LIVE_API_TESTS=False

# Subtitle Settings
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu

# Supporting Visuals Settings (Pillow Full HD)
DEFAULT_VISUAL_PROVIDER=local
VISUAL_WIDTH=1920
VISUAL_HEIGHT=1080

# Video Composition (FFmpeg Local Native Engine)
DEFAULT_COMPOSITION_PROVIDER=ffmpeg
FFMPEG_BINARY_PATH=ffmpeg
FFPROBE_BINARY_PATH=ffprobe
VIDEO_FPS=30
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
BURN_SUBTITLES=True

# Script Generation Timing Tolerances
SCRIPT_WORDS_PER_MINUTE=140
SCRIPT_DURATION_TOLERANCE_PERCENT=20
SCRIPT_DEFAULT_MAX_REVISIONS=1

# Localization Adaptation Settings
LOCALIZATION_MAX_REVISIONS=1
LOCALIZATION_DEFAULT_ADAPTATION_LEVEL=cultural_adaptation
